ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

MUHARNESS_SANDBOX_BACKEND=docker

QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus

SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=5


MEMORY_REFLECTION_ENABLED=true
MEMORY_REFLECTION_GATE_ENABLED=true
MEMORY_REFLECTION_PROVIDER=
MEMORY_REFLECTION_MODEL=
MEMORY_REFLECTION_MAX_OUTPUT_TOKENS=1200
MEMORY_REFLECTION_TEMPERATURE=0
MEMORY_REFLECTION_TIMEOUT_SECONDS=30
MEMORY_REFLECTION_MAX_TOOL_CONTEXT_CHARS=8000

MEMORY_MAINTENANCE_ENABLED=true
MEMORY_MAINTENANCE_PROVIDER=
MEMORY_MAINTENANCE_MODEL=
MEMORY_MAINTENANCE_MAX_OUTPUT_TOKENS=800
MEMORY_MAINTENANCE_TEMPERATURE=0
MEMORY_MAINTENANCE_TIMEOUT_SECONDS=30
MEMORY_MAINTENANCE_CANDIDATE_LIMIT=5
MEMORY_MAINTENANCE_MAX_ACTIONS=3

RUN_BUDGET_ENABLED=true
RUN_BUDGET_WARNING_TOKENS=80000
RUN_BUDGET_FINALIZATION_TOKENS=120000
RUN_BUDGET_HARD_TOKENS=160000
RUN_BUDGET_HARD_MODEL_CALLS=15
RUN_BUDGET_FINALIZATION_MAX_OUTPUT_TOKENS=1200
# 长任务 Executor 单独的 token 阈值（不沿用上面主对话的 RUN_BUDGET_*_TOKENS）
MEA_EXECUTOR_WARNING_TOKENS=300000
MEA_EXECUTOR_FINALIZATION_TOKENS=400000
MEA_EXECUTOR_HARD_TOKENS=500000

CONTEXT_SAFETY_MARGIN_TOKENS=4096
CONTEXT_TRIGGER_RATIO=0.80
CONTEXT_TARGET_RATIO=0.60
CONTEXT_PREFERRED_INPUT_TOKENS=64000
CONTEXT_WORKING_TRIGGER_RATIO=0.80
CONTEXT_WORKING_TARGET_RATIO=0.45
# 单一集中压缩阈值；未设置时取 preferred input 的两倍并受硬窗口限制。
# CONTEXT_COMPACT_INPUT_TOKENS=128000
# 工具结果首次进入模型时固定为完整文本或摘录，此后不会重新截断旧结果。
CONTEXT_KEEP_RECENT_TOOL_ROUNDS=2
CONTEXT_KEEP_RECENT_CONVERSATION_BLOCKS=4
CONTEXT_SUMMARY_MAX_OUTPUT_TOKENS=1024
CONTEXT_LARGE_FOLD_SPAN_TOKENS=50000
CONTEXT_SUMMARY_MAX_OUTPUT_TOKENS_LARGE_FOLD=2048
CONTEXT_MAX_TOOL_RESULT_CHARS=8000
CONTEXT_TOOL_RESULT_HEAD_CHARS=4000
CONTEXT_TOOL_RESULT_TAIL_CHARS=2000


SKILL_LEARNING_ENABLED=true
SKILL_LEARNING_BATCH_SIZE=20
SKILL_LEARNING_MIN_CLUSTER_SIZE=3
SKILL_LEARNING_PROVIDER=
SKILL_LEARNING_MODEL=
SKILL_LEARNING_TEMPERATURE=0
SKILL_LEARNING_MAX_OUTPUT_TOKENS=2000
SKILL_LEARNING_TIMEOUT_SECONDS=60
SKILL_LEARNING_DEFAULT_SCOPE=project

# 根目录只允许项目入口、源码目录和必要配置
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/evaluate.ps1
!/LICENSE*
!/NOTICE*
!/backend/
!/web/
!/workspace/

# 后端：源码、测试、沙箱构建与依赖配置
/backend/*
!/backend/app/
!/backend/tests/
!/backend/docker/
!/backend/requirements.txt
!/backend/requirements-dev.txt
!/backend/pyproject.toml
!/backend/.env.example

# 前端：源码、静态资源与构建配置
/web/*
!/web/src/
!/web/public/
!/web/index.html
!/web/package.json
!/web/package-lock.json
!/web/tsconfig*.json
!/web/vite.config.*
!/web/vitest.config.*

# 环境、密钥与本机工具配置
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
.venv/
venv/
env/
.conda/
.codex/
.agents/
.aws/
.vscode/
.idea/
*.code-workspace

# 数据库及其日志、备份文件
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite-*
*.sqlite.*
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.duckdb
*.rdb
*.mdb

# 文档、面经和报告
docs/
*.md
*.markdown
*.rst
*.adoc
*.doc
*.docx
*.odt
*.pdf
*.ppt
*.pptx
*.xls
*.xlsx
/backend/tests/eval/reports/

# 运行数据与工作文件
.muharness/
.oneagent/
output/
*.log
/workspace/*

# 依赖、缓存、构建结果与覆盖率
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
.coverage.*
htmlcov/
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
*.egg-info/
*.whl
*.zip
*.7z
*.rar
*.tar
*.gz
*.tgz

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 无密钥配置示例与空工作区
!/LICENSE*
!/NOTICE*
!/backend/.env.example
!/workspace/.gitkeep
